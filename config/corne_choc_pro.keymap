#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

/ {
    behaviors {
        kt_on: key_toggle_on_only {
            compatible = "zmk,behavior-key-toggle";
            #binding-cells = <1>;
            display-name = "Key Toggle On";
            toggle-mode = "on";
        };

        kt_off: key_toggle_off_only {
            compatible = "zmk,behavior-key-toggle";
            #binding-cells = <1>;
            display-name = "Key Toggle Off";
            toggle-mode = "off";
        };
    };

    macros {
        /* Hold SYMBOL. Releasing it also releases Command if Cmd+Tab latched it. */
        sym_layer: sym_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press &mo 2>,
                <&macro_pause_for_release>,
                <&macro_release &mo 2>,
                <&macro_tap &kt_off LGUI>;
        };

        /* SYMBOL + Tab: keep Command held so Tab can be tapped repeatedly. */
        app_switch_tab: app_switch_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kt_on LGUI>, <&kp TAB>;
        };

        /* On Danish macOS the grave accent key is dead; follow with Space for a literal `. */
        dk_grave: dk_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(EQUAL)>, <&kp SPACE>;
        };

        /* NUMBER + F: hold macOS Control + Option until F is released. */
        ctrl_option_hold: ctrl_option_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press &kp LCTRL &kp LALT>,
                <&macro_pause_for_release>,
                <&macro_release &kp LALT &kp LCTRL>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        num_and_symbol {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            // | TAB |  Q  |  W  |  E  |  R  |  T  | MUTE | PP   |  Y  |  U  |  I  |  O  |  P  |  Å   |
            // | ESC |  A  |  S  |  D  |  F  |  G  | LALT | RALT |  H  |  J  |  K  |  L  |  Æ  |  Ø   |
            // |SHFT |  Z  |  X  |  C  |  V  |  B  |             |  N  |  M  |  ,  |  .  |  /  | CTRL |
            //                   | GUI | NUM | SPC |             | ENT | SYM | SHFT |
            bindings = <
                &kp TAB   &kp Q &kp W &kp E &kp R &kp T &kp C_MUTE &kp C_PP &kp Y &kp U  &kp I     &kp O   &kp P    &kp LBKT
                &kp ESC   &kp A &kp S &kp D &kp F &kp G &kp LALT   &kp RALT &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B                     &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp LCTRL
                                      &kp LGUI &mo 1 &kp SPACE              &kp RET &sym_layer &kp RSHFT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        lower_layer {
            display-name = "NUMBER";
            // Vim navigation on H/J/K/L.
            // Hold F for Control+Option (Magnet), then use H/J/K/L for window movement.
            // Backspace intentionally exists only on SYMBOL.
            // | TAB |  1  |  2  |  3  |  4  |  5    | LCTRL | RCTRL |  6  |  7  |  8  |  9  |  0  |      |
            // | ESC | BT1 | BT2 | BT3 |C+OPT| BT5   | LALT  | RALT  | LEFT| DOWN| UP  |RIGHT| BT4 |      |
            // |SHFT |BTCR | RGB | RST | BOOT| Unlock|              |     |     |     |     |     | CTRL |
            //                   | GUI |     | SPC   |              | ENT |     | SHFT |
            bindings = <
                &kp TAB   &kp N1       &kp N2          &kp N3       &kp N4       &kp N5       &kp LCTRL &kp RCTRL &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &trans
                &kp ESC   &bt BT_SEL 0 &bt BT_SEL 1    &bt BT_SEL 2 &ctrl_option_hold &bt BT_SEL 4 &kp LALT &kp RALT &kp LEFT &kp DOWN &kp UP &kp RIGHT &bt BT_SEL 3 &trans
                &kp LSHFT &bt BT_CLR   &rgb_ug RGB_TOG &sys_reset   &bootloader  &studio_unlock                   &trans   &trans   &trans &trans    &trans &kp LCTRL
                                                       &kp LGUI     &trans       &kp SPACE                        &kp RET  &trans   &kp RSHFT
            >;
        };

        raise_layer {
            display-name = "SYMBOL";
            /*
             * Danish macOS symbol/edit layer.
             * J = Backspace
             * K = delete previous word (Option+Backspace)
             * Backspace intentionally lives only on this layer.
             *
             * Left hand                              Right hand
             * |CmdTab| ! | @ | # | $ | % |          | ( | ) | [ | ] | ? |BSPC|
             * | ESC  | ` | ~ | = | + | - |          | { |BSPC|WORD| } | \\ | | |
             * | SHFT | < | > | / | * | & |          | ' | \" | _ | : |   |CTRL|
             *                    |GUI|  |SPC|        |ENT|SYM|SHFT|
             *
             * The symbol bindings use the physical HID combinations for
             * the Danish keyboard layout rather than US-layout symbol aliases.
             */
            bindings = <
                &app_switch_tab &kp LS(N1)   &kp RA(N2)   &kp LS(N3)  &kp RA(N4)   &kp LS(N5)  &kp LCTRL &kp RCTRL &kp LS(N8) &kp LS(N9) &kp RA(N8)   &kp RA(N9)   &kp LS(MINUS) &kp BSPC
                &kp ESC         &dk_grave     &kp RA(RBKT) &kp LS(N0)  &kp MINUS    &kp FSLH    &kp LALT  &kp RALT  &kp RA(N7) &kp BSPC   &kp LA(BSPC) &kp RA(N0)   &kp RA(NUBS)  &kp RA(EQUAL)
                &kp LSHFT       &kp NUBS      &kp LS(NUBS)&kp LS(N7)  &kp LS(BSLH) &kp LS(N6)                         &kp BSLH   &kp LS(N2) &kp LS(FSLH) &kp LS(DOT)  &trans         &kp LCTRL
                                                         &kp LGUI      &trans        &kp SPACE                          &kp RET    &trans     &kp RSHFT
            >;
        };

        extra_layer_1 {
            display-name = "NUM+SYM";
            /*
             * Automatically active while NUMBER and SYMBOL are both held.
             * J = forward Delete.
             * RGB controls:
             *   R = toggle RGB       T = next effect
             *   Y = previous effect  U/I = brightness down/up
             *   O/P = speed down/up
             * Everything else falls through to NUMBER/SYMBOL.
             */
            bindings = <
                &trans &trans &trans &trans &rgb_ug RGB_TOG &rgb_ug RGB_EFF &trans &trans &rgb_ug RGB_EFR &rgb_ug RGB_BRD &rgb_ug RGB_BRI &rgb_ug RGB_SPD &rgb_ug RGB_SPI &trans
                &trans &trans &trans &trans &trans           &trans          &trans &trans &trans          &kp DEL          &trans          &trans          &trans          &trans
                &trans &trans &trans &trans &trans           &trans                        &trans          &trans           &trans          &trans          &trans          &trans
                                     &trans &trans &trans                                  &trans          &trans           &trans
            >;
        };

        extra_layer_2 {
            display-name = "EXTRA 2";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans
            >;
        };

        extra_layer_3 {
            display-name = "EXTRA 3";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans
            >;
        };

        extra_layer_4 {
            display-name = "EXTRA 4";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans
            >;
        };

        extra_layer_5 {
            display-name = "EXTRA 5";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans
            >;
        };

        extra_layer_6 {
            display-name = "EXTRA 6";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans
            >;
        };
    };
};
