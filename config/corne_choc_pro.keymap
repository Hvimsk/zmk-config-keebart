#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

/ {
    behaviors {

        /* Both left modifiers must be held before E: send Cmd+Shift+4.
         * Keep the physical modifiers; releasing E releases only the chosen key.
         */
        screenshot_shift: screenshot_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp E>, <&kp N4>;
            mods = <MOD_LSFT>;
            keep-mods = <MOD_LSFT>;
        };

        screenshot_e: screenshot_e {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp E>, <&screenshot_shift>;
            mods = <MOD_LGUI>;
            keep-mods = <MOD_LGUI>;
        };
        kt_on: key_toggle_on_only {
            compatible = "zmk,behavior-key-toggle";
            #binding-cells = <1>;
            display-name = "Key Toggle On";
            toggle-mode = "on";
        };

        kt_off: key_toggle_off_only {
            compatible = "zmk,behavior-key-toggle";
            #binding-cells = <1>;
            display-name = "Key Toggle Off";
            toggle-mode = "off";
        };
    };

    macros {
        /* Hold SYMBOL. Releasing it also releases Command if Cmd+Tab latched it. */
        sym_layer: sym_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press &mo 2>,
                <&macro_pause_for_release>,
                <&macro_release &mo 2>,
                <&macro_tap &kt_off LGUI>;
        };

        /* Hold NUMBER. Releasing it also releases Command if Cmd+Tab latched it. */
        num_layer: num_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press &mo 1>,
                <&macro_pause_for_release>,
                <&macro_release &mo 1>,
                <&macro_tap &kt_off LGUI>;
        };

        /* NUMBER/SYMBOL + Tab: keep Command held so Tab can be tapped repeatedly. */
        app_switch_tab: app_switch_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kt_on LGUI>, <&kp TAB>;
        };

        /* On Danish macOS the grave accent key is dead; follow with Space for a literal `. */
        dk_grave: dk_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(EQUAL)>, <&kp SPACE>;
        };

        /* NUMBER + F: hold macOS Control + Option until F is released. */
        ctrl_option_hold: ctrl_option_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press &kp LCTRL &kp LALT>,
                <&macro_pause_for_release>,
                <&macro_release &kp LALT &kp LCTRL>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        num_and_symbol {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // The four extra inner keys are disabled with &none on every layer.

        default_layer {
            display-name = "QWERTY";
            // | TAB |  Q  |  W  |  E  |  R  |  T  | OFF  | OFF  |  Y  |  U  |  I  |  O  |  P  |  Å   |
            // | ESC |  A  |  S  |  D  |  F  |  G  | OFF  | OFF  |  H  |  J  |  K  |  L  |  Æ  |  Ø   |
            // |SHFT |  Z  |  X  |  C  |  V  |  B  |             |  N  |  M  |  ,  |  .  |  /  | CTRL |
            //                   | GUI | NUM | SPC |             | ENT | SYM | SHFT |
            bindings = <
                &kp TAB   &kp Q &kp W &screenshot_e &kp R &kp T &none      &none    &kp Y &kp U  &kp I     &kp O   &kp P    &kp LBKT
                &kp ESC   &kp A &kp S &kp D &kp F &kp G &none      &none    &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B                     &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp LCTRL
                                      &kp LGUI &num_layer &kp SPACE          &kp RET &sym_layer &kp RSHFT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        lower_layer {
            display-name = "NUMBER";
            // Left-hand numpad: Q/W/E = 7/8/9, A/S/D = 4/5/6, Z/X/C = 1/2/3, V = 0.
            // Hold F for Control+Option (Magnet); H/J/K/L remain Left/Down/Up/Right.
            // Tab latches Cmd+Tab; releasing NUM releases Command.
            // Displaced Bluetooth and maintenance keys are on NUM+SYM.
            // G and SEMI still select Bluetooth profiles 5 and 4; B still unlocks Studio.
            // Backspace intentionally exists only on SYMBOL.
            bindings = <
                &app_switch_tab      &kp N7               &kp N8               &kp N9               &none                &none                &none                &none                &none                &none                &none                &none                &none                &trans
                &kp ESC              &kp N4               &kp N5               &kp N6               &ctrl_option_hold    &bt BT_SEL 4         &none                &none                &kp LEFT             &kp DOWN             &kp UP               &kp RIGHT            &bt BT_SEL 3         &trans
                &kp LSHFT            &kp N1               &kp N2               &kp N3               &kp N0               &studio_unlock       &trans               &trans               &trans               &trans               &trans               &kp LCTRL
                &kp LGUI             &trans               &kp SPACE            &kp RET              &trans               &kp RSHFT
            >;
        };

        raise_layer {
            display-name = "SYMBOL";
            /*
             * Danish macOS symbol/edit layer.
             * R = dollar via Shift+Option+3.
             * The far-right top-row key (base Å) sends Cmd+Shift+4 on SYMBOL.
             * The far-right home-row key (base Ø) sends pipe via Option+I.
             * Æ sends backslash via Shift+Option+7.
             * The bottom-right key remains Control.
             * H/L = braces via Shift+Option+8/9 on Danish macOS.
             * W = @ via Option + the Danish apostrophe key (HID BSLH).
             * The base-layer minus key also sends underscore while SYMBOL is held.
             * J = Backspace
             * K = delete previous word (Option+Backspace)
             * Backspace intentionally lives only on this layer.
             *
             * Left hand                              Right hand
             * |CmdTab| ! | @ | # | $ | % |          | ( | ) | [ | ] | ? |Shot|
             * | ESC  | ` | ~ | = | + | - |          | { |BSPC|WORD| } | \\ |Pipe|
             * | SHFT | < | > | / | * | & |          | ' | \" | _ | : | _ |CTRL|
             *                    |GUI|  |SPC|        |ENT|SYM|SHFT|
             *
             * The symbol bindings use the physical HID combinations for
             * the Danish keyboard layout rather than US-layout symbol aliases.
             */
            bindings = <
                &app_switch_tab &kp LS(N1)   &kp RA(BSLH)   &kp LS(N3)  &kp LS(RA(N3))   &kp LS(N5)  &none     &none     &kp LS(N8) &kp LS(N9) &kp RA(N8)   &kp RA(N9)   &kp LS(MINUS) &kp LG(LS(N4))
                &kp ESC         &dk_grave     &kp RA(RBKT) &kp LS(N0)  &kp MINUS    &kp FSLH    &none     &none     &kp LS(RA(N8)) &kp BSPC   &kp LA(BSPC) &kp LS(RA(N9))   &kp LS(RA(N7))  &kp RA(I)
                &kp LSHFT       &kp NUBS      &kp LS(NUBS)&kp LS(N7)  &kp LS(BSLH) &kp LS(N6)                         &kp BSLH   &kp LS(N2) &kp LS(FSLH) &kp LS(DOT)  &kp LS(FSLH)         &kp LCTRL
                                                         &kp LGUI      &trans        &kp SPACE                          &kp RET    &trans     &kp RSHFT
            >;
        };

        extra_layer_1 {
            display-name = "NUM+SYM";
            /*
             * Automatically active while NUMBER and SYMBOL are both held.
             * J = forward Delete.
             * RGB controls:
             *   R = toggle RGB       T = next effect
             *   Y = previous effect  U/I = brightness down/up
             *   O/P = speed down/up
             * A/S/D = Bluetooth profiles 1/2/3; Z = clear current Bluetooth profile.
             * X = toggle RGB; C = reset; V = bootloader.
             * Everything else falls through to NUMBER/SYMBOL.
             */
            bindings = <
                &trans               &trans               &trans               &trans               &rgb_ug RGB_TOG      &rgb_ug RGB_EFF      &none                &none                &rgb_ug RGB_EFR      &rgb_ug RGB_BRD      &rgb_ug RGB_BRI      &rgb_ug RGB_SPD      &rgb_ug RGB_SPI      &trans
                &trans               &bt BT_SEL 0         &bt BT_SEL 1         &bt BT_SEL 2         &trans               &trans               &none                &none                &trans               &kp DEL              &trans               &trans               &trans               &trans
                &trans               &bt BT_CLR           &rgb_ug RGB_TOG      &sys_reset           &bootloader          &trans               &trans               &trans               &trans               &trans               &trans               &trans
                &trans               &trans               &trans               &trans               &trans               &trans
            >;
        };

        extra_layer_2 {
            display-name = "EXTRA 2";
            bindings = <
                &trans &trans &trans &trans &trans &trans &none  &none  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &none  &none  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans
            >;
        };

        extra_layer_3 {
            display-name = "EXTRA 3";
            bindings = <
                &trans &trans &trans &trans &trans &trans &none  &none  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &none  &none  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans
            >;
        };

        extra_layer_4 {
            display-name = "EXTRA 4";
            bindings = <
                &trans &trans &trans &trans &trans &trans &none  &none  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &none  &none  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans
            >;
        };

        extra_layer_5 {
            display-name = "EXTRA 5";
            bindings = <
                &trans &trans &trans &trans &trans &trans &none  &none  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &none  &none  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans
            >;
        };

        extra_layer_6 {
            display-name = "EXTRA 6";
            bindings = <
                &trans &trans &trans &trans &trans &trans &none  &none  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &none  &none  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans
            >;
        };
    };
};
